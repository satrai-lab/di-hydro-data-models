{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:ngsi-ld:ModelSchema:HydropowerPlant-EU-9283746591823746",
  "title": "DeviceModel",
  "definitions": {
    "Device": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uri",
          "pattern": "^[\\w\\-\\.\\{\\}\\$\\+\\*\\[\\]`|~^@!,:\\\\]+$",
          "description": "Unique identifier of the entity"
        },
        "type": {
          "type": "string",
          "enum": [
            "Device"
          ],
          "description": "NGSI-LD entity type. Must be Device"
        },
        "name": {
          "type": "string",
          "description": "The name of the Device."
        },
        "onObject": {
          "type": "object",
          "description": "The component(s) of the HPP that this device is installed on",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "Relationship"
              ]
            },
            "object": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "additionalProperties": false
        },
        "inHPP": {
          "type": "object",
          "description": "The HydropowerPlant that this device belongs to",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "Relationship"
              ]
            },
            "object": {
              "type": "string",
              "format": "uri"
            }
          },
          "additionalProperties": false
        },
        "controlledObservation": {
          "type": "object",
          "description": "The observation types this device can control",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "Property"
              ]
            },
            "value": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "observations": {
          "type": "object",
          "description": "List of IDs of the observations produced by or connected to the device",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "Relationship"
              ]
            },
            "object": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "additionalProperties": false
        },
        "controlledActuation": {
          "type": "object",
          "description": "The actuation types this device can control",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "Property"
              ]
            },
            "value": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "actuations": {
          "type": "object",
          "description": "List of IDs of the actuations produced by or connected to the device",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "Relationship"
              ]
            },
            "object": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "additionalProperties": false
        },
        "deviceType": {
          "type": "string",
          "enum": [
            "sensor",
            "actuator",
            "sensorActuator",
            "Device",
            "System"
          ],
          "description": "Indicates the type of the device: sensor, actuator, or both"
        },
        "relativePosition": {
          "type": "object",
          "description": "Relative position of the device in 2D/3D space",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "Point",
                "LineString",
                "MultiLineString",
                "Polygon",
                "Trimesh"
              ]
            },
            "measurementUnit": {
              "type": "string"
            },
            "dimensions": {
              "type": "string",
              "enum": [
                "2D",
                "3D"
              ]
            },
            "coordinates": {
              "type": "array",
              "items": {}
            },
            "faces": {
              "type": "array",
              "items": {}
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}

