{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:ngsi-ld:ModelSchema:HydropowerPlant-EU-9283746591823746",
  "title": "HydropowerPlantModeling",
  "definitions": {
    "CatchmentArea": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uri",
          "pattern": "^[\\w\\-\\.\\{\\}\\$\\+\\*\\[\\]`|~^@!,:\\\\]+$"
        },
        "type": {
          "type": "string",
          "enum": ["CatchmentArea"]
        },
        "area": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number"
            },
            "unitCode": {
              "type": "string",
              "enum": ["KM2"]
            }
          }
        },
        "annualPrecipitationVolume": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number"
            },
            "unitCode": {
              "type": "string",
              "enum": ["M3"]
            }
          }
        },
        "seasonalRainfallDistribution": {
          "type": "object",
          "properties": {
            "spring": {
              "type": "number"
            },
            "summer": {
              "type": "number"
            },
            "autumn": {
              "type": "number"
            },
            "winter": {
              "type": "number"
            }
          }
        },
        "soilType": {
          "type": "string"
        },
        "vegetationCover": {
          "type": "string"
        },
        "flowVariationProfile": {
          "type": "object",
          "properties": {
            "jan":{
              "type": "number"
            },
            "feb": {
              "type": "number"
            },
            "mar": {
              "type": "number"
            },
            "apr": {
              "type": "number"
            },
            "may": {
              "type": "number"
            },
            "jun": {
              "type": "number"
            },
            "jul": {
              "type": "number"
            },
            "aug": {
              "type": "number"
            },
            "sep": {
              "type": "number"
            },
            "oct": {
              "type": "number"
            },
            "nov": {
              "type": "number"
            },
            "dec": {
              "type": "number"
            }
          }
        },
        "averageWaterFlow": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number"
          },
          "unitCode": {
            "type": "string",
            "enum": ["M3S"]
          }
        }
        },
        "suppliesWaterToWaterBody": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "suppliesWaterToHydroPowerPlant": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
