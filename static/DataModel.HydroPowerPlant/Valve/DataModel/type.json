{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:ngsi-ld:ModelSchema:HydropowerPlant-EU-9283746591823746",
  "title": "HydropowerPlantModeling",
  "definitions": {
    "Valve": {
      "type": "object",
      "required": ["id", "type", "name"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uri",
          "pattern": "^[\\w\\-\\.\\{\\}\\$\\+\\*\\[\\]`|~^@!,:\\\\]+$"
        },
        "type": {
          "type": "string",
          "enum": ["Valve"]
        },
        "name": {
          "type": "string"
        },
        "geographicalLocation": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["Point"]
            },
            "coordinates": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2
            }
          }
        },
        "valveType": {
          "type": "string",
          "enum": ["Gate Valve", "Butterfly Valve", "Ball Valve", "Sluice Gate"]
        },
        "material": {
          "type": "string",
          "enum": ["Stainless Steel", "Cast Iron", "Composite"]
        },
        "isPartOfHydroPowerPlant": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "isPartOfValveHouse": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "isConnectedToPenstock": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
