              "properties": {
                "value": {
                  "type": "number",
                  "description": "Upper bound of system bandwidth"
                },
                "unitCode": {
                  "type": "string",
                  "enum": ["kHz"],
                  "description": "Unit code for kilohertz"
                }
              },
              "additionalProperties": false
            },
            "acquisitionMode": {
              "type": "object",
              "description": "Data acquisition mode",
              "properties": {
                "value": {
                  "type": "string",
