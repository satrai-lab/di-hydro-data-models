{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:ngsi-ld:ModelSchema:HydropowerPlant-EU-9283746591823746",
  "title": "HydropowerPlantModeling",
  "description": "Data Model of Valve in Hydropower Plant Modeling",
  "definitions": {
    "Valve": {
      "allOf": [
        {
          "$ref": "https://raw.githubusercontent.com/satrai-lab/di-hydro-data-models/refs/heads/main/static/DataModel.HydroPowerPlant/GenericStaticComponent/DataModel/type.json#/definitions/GenericStaticComponent"
        },
        {
          "type": "object",
          "required": ["id", "type", "name"],
          "properties": {
            "id": {
              "type": "string",
              "format": "uri",
              "pattern": "^[\\w\\-\\.\\{\\}\\$\\+\\*\\[\\]`|~^@!,:\\\\]+$"
            },
            "type": {
              "type": "string",
              "enum": ["Valve"]
            },
            "name": {
              "type": "string"
            },
            "geographicalLocation": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["Point"]
                },
                "coordinates": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2
                }
              }
            },
            "valveType": {
              "type": "string",
              "enum": [
                "Gate Valve",
                "Butterfly Valve",
                "Ball Valve",
                "Sluice Gate"
              ]
            },
            "material": {
              "type": "string",
              "enum": ["Stainless Steel", "Cast Iron", "Composite"]
            },
            "isPartOfHydroPowerPlant": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              }
            },
            "isPartOfValveHouse": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              }
            },
            "isConnectedToPenstock": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
