{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:ngsi-ld:ModelSchema:HydropowerPlant-EU-9283746591823746",
  "title": "HydropowerPlantModeling",
  "definitions": {
    "HydroPump": {
      "type": "object",
      "required": ["id", "type", "name"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uri",
          "pattern": "^[\\w\\-\\.\\{\\}\\$\\+\\*\\[\\]`|~^@!,:\\\\]+$"
        },
        "type": {
          "type": "string",
          "enum": ["HydroPump"]
        },
        "name": {
          "type": "string"
        },
        "pumpCapacity": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number"
            },
            "unitCode": {
              "type": "string",
              "enum": ["MW", "M3S"]
            }
          }
        },
        "pumpEfficiency": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number"
            },
            "unitCode": {
              "type": "string",
              "enum": ["PCT"]
            }
          }
        },
        "operationalMode": {
          "type": "string",
          "enum": ["Pumping", "Generating"]
        },
        "powerConsumption": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number"
            },
            "unitCode": {
              "type": "string",
              "enum": ["MW"]
            }
          }
        },
        "cycleTime": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number"
            },
            "unitCode": {
              "type": "string",
              "enum": ["H"]
            }
          }
        },
        "PumpWaterTo": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "isPartOfHydrPowerPlant": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
