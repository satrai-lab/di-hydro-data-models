{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:ngsi-ld:ModelSchema:HydropowerPlant-EU-9283746591823746",
  "title": "DeviceModel",
  "description": "Data Model of UltrasonicTransducer of Hydropower Plant Modeling",
  "definitions": {
    "UltrasonicTransducer": {
      "allOf": [
        {
          "$ref": "https://raw.githubusercontent.com/satrai-lab/di-hydro-data-models/refs/heads/main/dynamic/DataModel.HydroPowerPlant/GenericDevice/DataModel/type.json#/definitions/Device"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uri",
              "pattern": "^[\\\\w\\\\-\\\\.\\\\{\\\\}\\\\$\\\\+\\\\*\\\\[\\\\]`|~^@!,:\\\\\\\\]+$",
              "description": "Unique URI identifier of this ultrasonic transducer entity"
            },
            "type": {
              "type": "string",
              "enum": ["UltrasonicTransducer"],
              "description": "NGSI-LD entity type. Must be UltrasonicTransducer"
            },
            "status": {
              "type": "object",
              "description": "Operational status",
              "properties": {
                "type": { "type": "string", "enum": ["Property"] },
                "value": { "type": "string", "description": "e.g. 'receiving_signal', 'idle'" }
              },
              "additionalProperties": false
            },
            "model": {
              "type": "object",
              "description": "Device model identifier",
              "properties": {
                "type": { "type": "string", "enum": ["Property"] },
                "value": { "type": "string" }
              },
              "additionalProperties": false
            },
            "manufacturer": {
              "type": "object",
              "description": "Name of the manufacturing company",
              "properties": {
                "type": { "type": "string", "enum": ["Property"] },
                "value": { "type": "string" }
              },
              "additionalProperties": false
            },
            "resonantFrequency": {
              "type": "object",
              "description": "Operating resonant frequency",
              "properties": {
                "type": { "type": "string", "enum": ["Property"] },
                "value": { "type": "number" },
                "unitCode": { "type": "string", "enum": ["kHz"] }
              },
              "additionalProperties": false
            },
            "powerRating": {
              "type": "object",
              "description": "Maximum power handling",
              "properties": {
                "type": { "type": "string", "enum": ["Property"] },
                "value": { "type": "number" },
                "unitCode": { "type": "string", "enum": ["W"] }
              },
              "additionalProperties": false
            },
            "material": {
              "type": "object",
              "description": "Main construction material",
              "properties": {
                "type": { "type": "string", "enum": ["Property"] },
                "value": { "type": "string" }
              },
              "additionalProperties": false
            },
            "mountType": {
              "type": "object",
              "description": "Installation method",
              "properties": {
                "type": { "type": "string", "enum": ["Property"] },
                "value": { "type": "string", "enum": ["adhesive", "magnetic"] }
              },
              "additionalProperties": false
            },
            "diameter": {
              "type": "object",
              "description": "Transducer face diameter",
              "properties": {
                "type": { "type": "string", "enum": ["Property"] },
                "value": { "type": "number" },
                "unitCode": { "type": "string", "enum": ["MMT"] }
              },
              "additionalProperties": false
            },
            "thickness": {
              "type": "object",
              "description": "Transducer thickness",
              "properties": {
                "type": { "type": "string", "enum": ["Property"] },
                "value": { "type": "number" },
                "unitCode": { "type": "string", "enum": ["MMT"] }
              },
              "additionalProperties": false
            },
            "protectionGrade": {
              "type": "object",
              "description": "Ingress protection rating",
              "properties": {
                "type": { "type": "string", "enum": ["Property"] },
                "value": { "type": "string", "description": "e.g. 'IP68'" }
              },
              "additionalProperties": false
            },
            "controlledBy": {
              "type": "array",
              "description": "References to the driving Ultrasonic Generator entity",
              "items": { "type": "string", "format": "uri" }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
