{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:ngsi-ld:ModelSchema:HydropowerPlant-EU-9283746591823746",
  "title": "HydropowerPlantModeling",
  "description": "Data Model of Generator in Hydropower Plant Modeling",
  "definitions": {
    "Generator": {
      "allOf": [
        {
          "$ref": "https://raw.githubusercontent.com/satrai-lab/di-hydro-data-models/refs/heads/main/static/DataModel.HydroPowerPlant/GenericStaticComponent/DataModel/type.json#/definitions/GenericStaticComponent"
        },
        {
          "type": "object",
          "required": ["id", "type", "name"],
          "properties": {
            "id": {
              "type": "string",
              "format": "uri",
              "pattern": "^[\\w\\-\\.\\{\\}\\$\\+\\*\\[\\]`|~^@!,:\\\\]+$"
            },
            "type": {
              "type": "string",
              "enum": ["Generator"]
            },
            "name": {
              "type": "string"
            },
            "ratedCapacity": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number"
                },
                "unitCode": {
                  "type": "string",
                  "enum": ["MW"]
                }
              }
            },
            "efficiency": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number"
                },
                "unitCode": {
                  "type": "string",
                  "enum": ["PCT"]
                }
              }
            },
            "manufacturer": {
              "type": "string"
            },
            "yearOfInstallation": {
              "type": "number"
            },
            "generatorType": {
              "type": "string"
            },
            "axis": {
              "type": "string",
              "enum": ["Horizontal", "Vertical"]
            },
            "voltageLevel": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number"
                },
                "unitCode": {
                  "type": "string",
                  "enum": ["KV"]
                }
              }
            },
            "ratedOutputMVA": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number"
                },
                "unitCode": {
                  "type": "string",
                  "enum": ["MVA"]
                }
              }
            },
            "speed": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number"
                },
                "unitCode": {
                  "type": "string",
                  "enum": ["RPM"]
                }
              }
            },
            "ratedPowerFactor": {
              "type": "number"
            },
            "voltageRegulationRange": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number"
                },
                "unitCode": {
                  "type": "string",
                  "enum": ["PCT"]
                }
              }
            },
            "windingInsulationClass": {
              "type": "string"
