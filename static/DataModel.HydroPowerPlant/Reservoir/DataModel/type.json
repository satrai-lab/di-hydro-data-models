{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:ngsi-ld:ModelSchema:HydropowerPlant-EU-9283746591823746",
  "title": "HydropowerPlantModeling",
  "definitions": {
    "WaterBody": {
      "type": "object",
      "required": ["id", "type", "name"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uri",
          "pattern": "^[\\w\\-\\.\\{\\}\\$\\+\\*\\[\\]`|~^@!,:\\\\]+$"
        },
        "type": {
          "type": "string",
          "enum": ["WaterBody"]
        },
        "name": {
          "type": "string"
        },
        "waterBodyCategory": {
          "type": "string",
          "enum": ["River", "Lake", "Reservoir", "Other"]
        },
        "geographicalLocation": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["Point"]
            },
            "coordinates": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2
            }
          }
        },
        "surfaceArea": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number"
            },
            "unitCode": {
              "type": "string",
              "enum": ["KM2"]
            }
          }
        },
        "length": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number"
            },
            "unitCode": {
              "type": "string",
              "enum": ["KM"]
            }
          }
        },
        "averageDepth": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number"
            },
            "unitCode": {
              "type": "string",
              "enum": ["M"]
            }
          }
        },
        "averageFlowRate": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number"
            },
            "unitCode": {
              "type": "string",
              "enum": ["M3S"]
            }
          }
        },
        "peakFlow": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              },
              "unitCode": {
                "type": "string",
                "enum": ["M3S"]
              }
            }
        },
        "seasonalVariation": {
              "type": "object",
              "properties": {
                "winter": {
                  "type": "number"
                },
                "spring": {
                  "type": "number"
                },
                "summer": {
                  "type": "number"
                },
                "autumn": {
                  "type": "number"
                }
              }
            },
        "averageWaterLevel": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number"
            },
            "unitCode": {
              "type": "string",
              "enum": ["M"]
            }
          }
        },
        "operationalData": {
          "type": "object",
          "properties": {
            "floodRisk": {
              "type": "string",
              "enum": ["Low", "Medium", "High"]
            },
            "waterRights": {
              "type": "string",
              "enum": ["Public", "Private", "Mixed"]
            }
          }
        },
        "isFedBy": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "isPartOfHydroPowerPlant": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "additionalProperties": false
    },
    "Reservoir": {
      "allOf": [
        {
          "$ref": "#/definitions/WaterBody"
        },
        {
          "type": "object",
          "properties": {
