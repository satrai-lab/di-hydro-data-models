{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:ngsi-ld:ModelSchema:HydropowerPlant-EU-9283746591823746",
  "title": "DeviceModel",
  "description": "Data Model of TlfSensor of Hydropower Plant Modeling",
  "definitions": {
