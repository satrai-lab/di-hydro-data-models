{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:ngsi-ld:ModelSchema:HydropowerPlant-EU-9283746591823746",
  "title": "HydropowerPlantModeling",
  "definitions": {

    "HydroPowerCommunity": {
    "type": "object",
    "required": ["id", "type", "name"],
    "properties": {
      "id": {
        "type": "string",
        "format": "uri",
        "pattern": "^[\\w\\-\\.\\{\\}\\$\\+\\*\\[\\]`|~^@!,:\\\\]+$"
      },
      "type": {
        "type": "string",
        "enum": ["Community"]
      },
      "name": {
        "type": "string"
      },
      "region": {
        "type": "string"
      },
      "establishedYear": {
        "type": "number"
      },
      "totalInstalledCapacity": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number"
          },
          "unitCode": {
            "type": "string",
            "enum": ["MW"]
          }
        }
      },
      "totalAnnualEnergyOutput": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number"
          },
          "unitCode": {
            "type": "string",
            "enum": ["KWH"]
          }
        }
      },
      "governanceModel": {
        "type": "string"
      },
      "contactEmail": {
        "type": "string",
        "format": "email"
      },
      "websiteURL": {
        "type": "string",
        "format": "uri"
      },
      "hasHPP": {
        "type": "array",
        "items": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "x-ngsi": {
      "uri-prefix": "https://raw.githubusercontent.com/satrai-lab/di-hydro-data-models/refs/heads/main/static/types-defenitions.json#"
    }
    }
  }
}
