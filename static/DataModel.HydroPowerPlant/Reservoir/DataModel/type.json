                }
              }
            },
            "historicalMinLevel": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number"
                },
                "unitCode": {
                  "type": "string",
                  "enum": ["M"]
                }
              }
            },
            "maxReservoirLevel": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              },
              "unitCode": {
                "type": "string",
                "enum": ["M"]
              }
            }
            },
            "normalReservoirLevel": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              },
              "unitCode": {
                "type": "string",
                "enum": ["M"]
              }
            }
            },
            "reservoirLength": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              },
              "unitCode": {
                "type": "string",
                "enum": ["KM"]
              }
            }
            },
            "maximumEnergeticVolume": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              },
              "unitCode": {
                "type": "string",
                "enum": ["GWH"]
              }
            }
            },
            "reservoirType": {
            "type": "string",
            "enum": ["seasonal", "weekly", "daily"]
            },
            "grossVolume": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number"
                },
                "unitCode": {
                  "type": "string",
                  "enum": ["M3"]
                }
              }
            },
            "usefulVolume": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number"
                },
                "unitCode": {
                  "type": "string",
                  "enum": ["M3"]
                }
              },
            },
            "hasPressureTunnel": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
            },
            "fedByPumpingStation": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
            },
            "hasDams": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              }
            },
            "feedsIntakes": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        }
