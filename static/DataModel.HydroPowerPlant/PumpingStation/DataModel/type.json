{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:ngsi-ld:ModelSchema:HydropowerPlant-EU-9283746591823746",
  "title": "HydropowerPlantModeling",
  "definitions": {
    "PumpingStation": {
        "required": ["id", "type", "name"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uri",
            "pattern": "^[\\w\\-\\.\\{\\}\\$\\+\\*\\[\\]`|~^@!,:\\\\]+$"
          },
          "type": {
            "type": "string",
            "enum": ["PumpingStation"]
          },
          "name": {
            "type": "string"
          },
          "totalPower": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              },
              "unitCode": {
                "type": "string",
                "enum": ["MW"]
              }
            }
          },
          "unitCount": {
            "type": "number"
          },
          "yearlyEnergyConsumption": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              },
              "unitCode": {
                "type": "string",
                "enum": ["KWH"]
              }
            }
          },
          "estimatedAnnualContribution": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              },
              "unitCode": {
                "type": "string",
                "enum": ["MWH"]
              }
            }
          },
          "feedsReservoir": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "increasesProductionAt": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "additionalProperties": false
    }
  }
}
