{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:ngsi-ld:ModelSchema:HydropowerPlant-EU-9283746591823746",
  "title": "HydropowerPlantModeling",
  "description": "Data Model of CatchmentArea in Hydropower Plant Modeling",
  "definitions": {
    "CatchmentArea": {
      "allOf": [
        {
          "$ref": "https://raw.githubusercontent.com/satrai-lab/di-hydro-data-models/refs/heads/main/static/DataModel.HydroPowerPlant/GenericStaticComponent/DataModel/type.json#/definitions/GenericStaticComponent"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uri",
              "description": "Unique identifier of the Catchment Area"
            },
            "type": {
              "type": "string",
              "enum": ["CatchmentArea"],
              "description": "NGSI Entity type. It must be CatchmentArea"
            },
            "area": {
              "type": "object",
              "description": "The total area of the catchment in square kilometers",
              "properties": {
                "value": {
                  "type": "number"
                },
                "unitCode": {
                  "type": "string",
                  "enum": ["KM2"]
                }
              },
              "additionalProperties": false
            },
            "annualPrecipitationVolume": {
              "type": "object",
              "description": "The total volume of rainfall collected annually in the catchment area (in cubic meters)",
              "properties": {
                "value": {
                  "type": "number"
                },
                "unitCode": {
                  "type": "string",
                  "enum": ["M3"]
                }
              },
              "additionalProperties": false
            },
            "seasonalRainfallDistribution": {
              "type": "array",
              "description": "Distribution of annual rainfall across seasons as percentages. [Spring, Summer, Autumn, Winter]",
              "items": {
                "type": "number"
              }
            },
            "soilType": {
              "type": "string",
              "description": "Classification of soil in the catchment area"
            },
            "vegetationCover": {
              "type": "string",
              "description": "Information on the types and extent of vegetation in the catchment"
            },
            "flowVariationProfile": {
              "type": "array",
              "description": "Array of monthly water flow rates in m³/s: [Jan, Feb, ..., Dec]",
              "items": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number"
                  },
                  "unitCode": {
                    "type": "string",
                    "enum": ["M3S"]
                  }
                },
                "additionalProperties": false
              }
            },
            "averageWaterFlow": {
              "type": "object",
              "description": "Average historical water flow (in cubic meters per second)",
              "properties": {
                "value": {
                  "type": "number"
                },
                "unitCode": {
                  "type": "string",
                  "enum": ["M3S"]
                }
              },
              "additionalProperties": false
            },
            "suppliesWaterToWaterBody": {
              "type": "array",
              "description": "Array of references to Water Body entities that are supplied by this catchment area",
              "items": {
                "type": "string",
                "format": "uri"
              }
            },
            "suppliesWaterToHydroPowerPlant": {
              "type": "array",
              "description": "Array of references to HydropowerPlant entities that are supplied by this catchment area",
              "items": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
