            "isPartOfHydroPowerPlant": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              }
            },
            "isDrivenByTurbines": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              }
            },
            "hasTransformers": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              }
            },
            "isPartOfPowerHouse": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
