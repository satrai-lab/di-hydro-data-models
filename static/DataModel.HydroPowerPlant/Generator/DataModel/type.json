{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:ngsi-ld:ModelSchema:HydropowerPlant-EU-9283746591823746",
  "title": "HydropowerPlantModeling",
  "description": "Updated Data Model of Generator in Hydropower Plant Modeling",
  "definitions": {
    "Generator": {
      "allOf": [
        {
          "$ref": "https://raw.githubusercontent.com/satrai-lab/di-hydro-data-models/refs/heads/main/static/DataModel.HydroPowerPlant/GenericStaticComponent/DataModel/type.json#/definitions/GenericStaticComponent"
        },
        {
          "type": "object",
          "required": ["id", "type", "name"],
          "properties": {
            "id": {
              "type": "string",
              "format": "uri",
              "pattern": "^[\\w\\-\\.\\{\\}\\$\\+\\*\\[\\]`|~^@!,:\\\\]+$"
            },
            "type": {
              "type": "string",
              "enum": ["Generator"]
            },
            "name": {
              "type": "string"
            },
            "generatorType": {
              "type": "string",
              "enum": ["Synchronous", "Asynchronous", "DC", "PermanentMagnet"],
              "description": "Technical type of the generator based on electrical operation principle."
            },
            "generatorModel": {
              "type": "string",
              "description": "Commercial or manufacturer model of the generator."
            },
            "ratedCapacity": {
              "type": "object",
              "properties": {
                "value": { "type": "number" },
                "unitCode": { "type": "string", "enum": ["MW"] }
              }
            },
            "efficiency": {
              "type": "object",
              "properties": {
                "value": { "type": "number" },
                "unitCode": { "type": "string", "enum": ["PCT"] }
              }
            },
            "manufacturer": {
              "type": "string"
            },
            "yearOfInstallation": {
              "type": "number"
            },
            "axis": {
              "type": "string",
              "enum": ["Horizontal", "Vertical"]
            },
            "voltageLevel": {
              "type": "object",
              "properties": {
                "value": { "type": "number" },
                "unitCode": { "type": "string", "enum": ["KV"] }
              }
            },
            "ratedOutputMVA": {
              "type": "object",
              "properties": {
                "value": { "type": "number" },
                "unitCode": { "type": "string", "enum": ["MVA"] }
              }
            },
            "connectionToGrid": {
              "type": "object",
              "description": "Voltage level of connection between generator and grid.",
              "properties": {
                "value": { "type": "number" },
                "unitCode": { "type": "string", "enum": ["KV"] }
              }
            },
            "transformersQuantity": {
              "type": "integer",
              "description": "Number of transformers connected to the generator."
            },
            "transformersApparentPower": {
              "type": "object",
              "description": "Total apparent power of connected transformers.",
              "properties": {
                "value": { "type": "number" },
                "unitCode": { "type": "string", "enum": ["MVA"] }
              }
            },
            "industrialControlSystem": {
              "type": "string",
              "description": "Type or name of the industrial control system (e.g., SCADA, PLC)."
            },
            "speed": {
              "type": "object",
              "properties": {
                "value": { "type": "number" },
                "unitCode": { "type": "string", "enum": ["RPM"] }
              }
            },
            "ratedPowerFactor": {
              "type": "number"
            },
            "voltageRegulationRange": {
              "type": "object",
              "properties": {
                "value": { "type": "number" },
                "unitCode": { "type": "string", "enum": ["PCT"] }
              }
            },
            "windingInsulationClass": {
              "type": "string"
            },
            "isPartOfHydroPowerPlant": {
              "type": "array",
              "items": { "type": "string", "format": "uri" }
            },
            "isDrivenByTurbines": {
              "type": "array",
              "items": { "type": "string", "format": "uri" }
            },
            "hasTransformers": {
              "type": "array",
              "items": { "type": "string", "format": "uri" }
            },
            "isPartOfPowerHouse": {
              "type": "array",
              "items": { "type": "string", "format": "uri" }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
