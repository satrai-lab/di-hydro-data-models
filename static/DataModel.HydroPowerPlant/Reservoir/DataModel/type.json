                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "number"
                    },
                    "unitCode": {
                      "type": "string",
                      "enum": ["KM2"]
                    }
                  }
                },
                "averageDepth": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "number"
