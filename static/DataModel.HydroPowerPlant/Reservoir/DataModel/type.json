            "fedByPumpingStation": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
            },
            "hasDams": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              }
            },
            "feedsIntakes": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
