{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:ngsi-ld:ModelSchema:HydropowerPlant-EU-9283746591823746",
  "title": "DeviceModel",
  "description": "Data Model of Geroscope of Hydropower Plant Modeling",
  "definitions": {
    "Geroscope": {
      "allOf": [
        {
          "$ref": "https://raw.githubusercontent.com/satrai-lab/di-hydro-data-models/refs/heads/main/dynamic/DataModel.HydroPowerPlant/GenericDevice/DataModel/type.json#/definitions/Device"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uri",
              "pattern": "^[\\\\w\\\\-\\\\.\\\\{\\\\}\\\\$\\\\+\\\\*\\\\[\\\\]`|~^@!,:\\\\\\\\]+$",
              "description": "Unique URI identifier of this gyroscope entity"
            },
            "type": {
              "type": "string",
              "enum": [
                "Geroscope"
              ],
              "description": "NGSI-LD entity type. Must be Geroscope"
            },
            "axes": {
              "type": "object",
              "description": "Number of rotation axes",
              "properties": {
                "value": { "type": "integer" },
                "unitCode": {
                  "type": "string",
                  "enum": [ "" ]
                }
              },
              "additionalProperties": false
            },
            "measurementRanges": {
              "type": "object",
              "description": "Supported angular-rate measurement ranges",
              "properties": {
                "value": {
                  "type": "array",
                  "items": { "type": "number" }
                },
                "unitCode": {
                  "type": "string",
                  "enum": [ "DEG/S" ]
                }
              },
              "additionalProperties": false
            },
            "resolution": {
              "type": "object",
              "description": "ADC conversion resolution",
              "properties": {
                "value": { "type": "integer" },
                "unitCode": {
                  "type": "string",
                  "enum": [ "bit" ]
                }
              },
              "additionalProperties": false
            },
            "isComponentOf": {
              "type": "array",
              "description": "The Sense HAT B board this gyroscope module belongs to",
              "items": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
